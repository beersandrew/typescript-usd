#usda 1.0
(
    "Created by UsdView"
    customLayerData = {
        string audit = "native-save-reference"
    }
    defaultPrim = "World"
    endTimeCode = 24
    framesPerSecond = 24
    metersPerUnit = 0.01
    startTimeCode = 0
    subLayers = [
        @<checkout>/tests/fixtures/usd-workflow/native-audit/fixtures/root.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "World"
{
    over "Shape" (
        variants = {
            string shape = "large"
        }
    )
    {
        token visibility = "invisible"
    }
}

