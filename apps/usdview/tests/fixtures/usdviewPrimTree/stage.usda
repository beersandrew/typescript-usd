#usda 1.0

def Xform "World"
{
    def Xform "Active" (
        displayName = "Friendly prim"
        uiHints = {
            string displayName = "Friendly prim"
        }
    )
    {
    }

    def Xform "Inactive" (
        active = false
    )
    {
    }

    def Xform "Source"
    {
        def Xform "Geom"
        {
        }
    }

    over "Undefined"
    {
        over Xform "Child"
        {
        }
    }

    class "Abstract"
    {
        def Xform "Child"
        {
        }
    }

    def Xform "Instance" (
        instanceable = true
        prepend references = </World/Source>
    )
    {
    }
}

