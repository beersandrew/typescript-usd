#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 10
    startTimeCode = 0
    upAxis = "Y"
)

def Xform "World" (
    kind = "assembly"
)
{
    def Xform "Group" (
        kind = "group"
    )
    {
        token visibility = "invisible"

        def Xform "Model" (
            kind = "component"
        )
        {
            def Mesh "Mesh" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/Looks/Mat>
                rel material:binding:preview = </World/Looks/Preview>
            }

            def Mesh "Generic" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/Looks/Mat>
            }
        }

        def Xform "Sibling"
        {
            def Cube "Box"
            {
            }
        }
    }

    def Xform "Payload" (
        kind = "component"
        prepend payload = @./payload.usda@</Asset>
    )
    {
    }

    def Xform "Inactive" (
        active = false
    )
    {
        def Cube "Child"
        {
        }
    }

    def Xform "Other"
    {
        def Sphere "Ball"
        {
        }
    }

    def Xform "Animated"
    {
        double3 xformOp:translate.timeSamples = {
            0: (0, 0, 0),
            10: (10, 0, 0),
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "Cam"
    {
    }

    def Scope "Looks"
    {
        def Material "Mat"
        {
        }

        def Material "Preview"
        {
        }
    }
}

def Material "RootMaterial"
{
}

over "RootOver"
{
}

class Xform "RootClass"
{
}

def Xform "RootInactive" (
    active = false
)
{
}
