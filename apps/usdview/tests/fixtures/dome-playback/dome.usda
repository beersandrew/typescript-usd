#usda 1.0
(
    "Written for dome-playback.test.ts: a textured DomeLight and a sphere under an Xform whose transform and visibility are time-sampled (always visible), as a unit of a playback scene. Authored by hand for the test; the sky_*.png images are flat 8x4 colors written for it."
    startTimeCode = 1
    endTimeCode = 10
    upAxis = "Y"
)

def Xform "Unit"
{
    token visibility.timeSamples = {
        1: "inherited",
        10: "inherited",
    }
    double3 xformOp:translate.timeSamples = {
        1: (0, 0, 0),
        10: (1, 0, 0),
    }
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def DomeLight "Dome"
    {
        float inputs:intensity = 1
        asset inputs:texture:file = @./sky_a.png@
        token inputs:texture:format = "latlong"
    }

    def Sphere "Ball"
    {
        double radius = 1
    }
}
