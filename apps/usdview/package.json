{
  "name": "typescript-usdview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A browser-native viewer for TypeScript USD and Storm",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --force",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc --noEmit -p tsconfig.ui.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mtlx/core": "workspace:*",
    "@mtlx/format": "workspace:*",
    "@vdb/nanovdb": "workspace:*",
    "@vdb/openvdb": "workspace:*",
    "typescript-usd": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webgpu/types": "^0.1.74",
    "jsdom": "26.1.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.6"
  }
}
