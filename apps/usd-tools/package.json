{
  "name": "usd-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenUSD's command-line tools as small web pages, run by TypeScript USD in the browser",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "samples": "node scripts/samples.mjs"
  },
  "dependencies": {
    "typescript-usd": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "@webgpu/types": "^0.1.74"
  }
}
