#usda 1.0
(
    defaultPrim = "formats"
    doc = "Forgery package_texture on piece usdz: a red label beside the blue print. This is what a viewer with that bug shows; the correct exhibit is ../formats.usda. Generated by usd-tour museum/src/export.py (usd-tour 6816c3a); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../formats.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "formats"
{
    over "Pieces"
    {
        over "usdz"
        {
            over "Holder"
            {
                over "Case"
                {
                    over "Looks"
                    {
                        over "Label"
                        {
                            over "Tex"
                            {
                                asset inputs:file = @./textures/label.png@
                            }
                        }
                    }
                }
            }
        }
    }
}

