#usda 1.0
(
    """Stagehand recipe schemas (spike, W13). Codeless: no C++ is generated, so any
    OpenUSD build loads it from plugInfo.json, and other implementations only need to
    read generatedSchema.usda. The baked mesh stays ordinary UsdGeomMesh data; these
    schemas record how it was made so any tool can rebuild it."""
    subLayers = [
        @usd/schema.usda@,
        @usdGeom/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "stagehand"
        string libraryPath = "."
        bool skipCodeGeneration = true
    }
) {}

class "StagehandRevolveAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
        token[] apiSchemaCanOnlyApplyTo = ["Mesh"]
    }
    doc = """The mesh is a profile revolved around +Y. Bake writes points,
    faceVertexCounts, faceVertexIndices and extent from these values."""
)
{
    float2[] stagehand:revolve:profile = [] (doc = "(radius, height) pairs from bottom to top.")
    int stagehand:revolve:segments = 16 (doc = "Steps around the axis.")
}

class "StagehandNoiseAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
        token[] apiSchemaCanOnlyApplyTo = ["Mesh"]
    }
    doc = """Roughen the baked points along their normals with seeded value noise.
    Applied after the shape recipe."""
)
{
    float stagehand:noise:amount = 0.05
    float stagehand:noise:size = 0.25
    int stagehand:noise:seed = 0
    uniform token stagehand:noise:space = "local" (allowedTokens = ["local", "world"])
}

class "StagehandSpinAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
        token[] apiSchemaCanOnlyApplyTo = ["Xformable"]
    }
    doc = """Steady turn about Y. Bake writes time samples to a rotateY:spin xformOp,
    so viewers that know nothing of this schema (AR Quick Look) still play it."""
)
{
    double stagehand:spin:turns = 1
    double stagehand:spin:start = 0
    double stagehand:spin:end = 240
}

class Beat "Beat" (
    inherits = </Typed>
    doc = "A moment of the play: the line spoken at a time code. Not drawn."
)
{
    double stagehand:beat:time = 0
    string stagehand:beat:line = ""
}
