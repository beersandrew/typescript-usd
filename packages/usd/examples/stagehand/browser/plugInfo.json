# The Stagehand plugin for typescript-usdview: the codeless schema (resources/)
# plus a library (stagehand.js, built by build.mjs from ../revolve.ts and
# ../imaging.ts) holding the OpenExec computations and the imaging adapter.
# Register it with ?plugin=<this file>; turn on exec imaging with
# ?env=USDIMAGINGGL_ENGINE_ENABLE_EXEC_SCENE_INDEX=1.
{
    "Plugins": [
        {
            "Info": {
                "Types": {
                    "StagehandBeat": {
                        "alias": {
                            "UsdSchemaBase": "Beat"
                        },
                        "autoGenerated": true,
                        "bases": [
                            "UsdTyped"
                        ],
                        "schemaIdentifier": "Beat",
                        "schemaKind": "concreteTyped"
                    },
                    "StagehandStagehandNoiseAPI": {
                        "alias": {
                            "UsdSchemaBase": "StagehandNoiseAPI"
                        },
                        "apiSchemaCanOnlyApplyTo": [
                            "Mesh"
                        ],
                        "autoGenerated": true,
                        "bases": [
                            "UsdAPISchemaBase"
                        ],
                        "schemaIdentifier": "StagehandNoiseAPI",
                        "schemaKind": "singleApplyAPI"
                    },
                    "StagehandStagehandRevolveAPI": {
                        "alias": {
                            "UsdSchemaBase": "StagehandRevolveAPI"
                        },
                        "apiSchemaCanOnlyApplyTo": [
                            "Mesh"
                        ],
                        "autoGenerated": true,
                        "bases": [
                            "UsdAPISchemaBase"
                        ],
                        "schemaIdentifier": "StagehandRevolveAPI",
                        "schemaKind": "singleApplyAPI"
                    },
                    "StagehandStagehandSpinAPI": {
                        "alias": {
                            "UsdSchemaBase": "StagehandSpinAPI"
                        },
                        "apiSchemaCanOnlyApplyTo": [
                            "Xformable"
                        ],
                        "autoGenerated": true,
                        "bases": [
                            "UsdAPISchemaBase"
                        ],
                        "schemaIdentifier": "StagehandSpinAPI",
                        "schemaKind": "singleApplyAPI"
                    }
                },
                "Exec": {
                    "Schemas": {
                        "StagehandStagehandRevolveAPI": {}
                    }
                }
            },
            "LibraryPath": "stagehand.js",
            "Name": "stagehand",
            "ResourcePath": ".",
            "Root": ".",
            "Type": "library"
        }
    ]
}
