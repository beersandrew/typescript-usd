#usda 1.0
(
    defaultPrim = "Heath"
    doc = """Macbeth 1.1, the heath: the witches' robes and the cauldron are
    stored only as recipes (StagehandRevolveAPI). OpenExec computes their
    shapes; the Stagehand imaging adapter hands them to Hydra. Transforms are
    xformOp:transform, the one op OpenExec's execGeom reads today. The First
    Witch's robe and the cauldron are animated recipes."""
    endTimeCode = 96
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 24
    upAxis = "Y"
)

