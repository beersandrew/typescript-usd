#usda 1.0
(
    defaultPrim = "ThumbnailGenerator"
    metersPerUnit = 0.01
    subLayers = [
        @cube_rainbow.usd@
    ]
    upAxis = "Y"
)

def Xform "ThumbnailGenerator"
{
    def Camera "MainCamera"
    {
        float2 clippingRange = (1.5833334, 10.333333)
        float focusDistance = 168.60936
        float fStop = 0
        float horizontalAperture = 24
        float horizontalApertureOffset = 0
        token projection = "perspective"
        float verticalAperture = 24
        float verticalApertureOffset = 0
        double3 xformOp:translate = (0, 0, 5.166666666666667)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

over "cube"
{
    uniform token model:drawMode = "default"
}

