#usda 1.0
(
    upAxis = "Z"
)

def DomeLight "Dome"
{
    float inputs:intensity = 0.5
    asset inputs:texture:file = @dome.hdr@
    token inputs:texture:format = "latlong"
    rel portals = </Portal>
    rel light:filters = </Filter>
}

def DomeLight_1 "Dome1"
{
    token poleAxis = "scene"
    color3f inputs:color = (1, 0.5, 0.25)
}

def DomeLight_1 "Dome1Z"
{
    token poleAxis = "Z"
}

def PortalLight "Portal"
{
    double3 xformOp:translate = (0, 0, 5)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def RectLight "Rect"
{
    float inputs:width = 2
    float inputs:height = 3
    float inputs:intensity = 10
    float inputs:exposure = 1
    bool inputs:normalize = 1
    double3 xformOp:translate = (1, 2, 3)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def SphereLight "Sphere" (
    prepend apiSchemas = ["ShapingAPI", "ShadowAPI"]
)
{
    float inputs:radius = 0.25
    float inputs:shaping:cone:angle = 45
    float inputs:shaping:cone:softness = 0.1
    bool inputs:shadow:enable = 0
    bool inputs:enableColorTemperature = 1
    float inputs:colorTemperature = 3000
    bool treatAsPoint = 1
}

def DistantLight "Distant"
{
    float inputs:angle = 1
    float inputs:intensity = 3
    token visibility = "invisible"
}

def DiskLight "Disk"
{
    float inputs:radius = 2
}

def CylinderLight "Cylinder"
{
    float inputs:length = 4
    float inputs:radius = 0.5
    float inputs:diffuse = 0.5
    float inputs:specular = 0.25
}

def LightFilter "Filter"
{
    float inputs:density = 0.5
}

def PluginLightFilter "PluginFilter"
{
}

def PluginLight "Plugin"
{
}

def Mesh "MeshLight" (
    prepend apiSchemas = ["MeshLightAPI"]
)
{
    int[] faceVertexCounts = [3]
    int[] faceVertexIndices = [0, 1, 2]
    point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    float inputs:intensity = 2
}

def Sphere "SphereWithLightAPI" (
    prepend apiSchemas = ["LightAPI"]
)
{
    float inputs:intensity = 7
}
