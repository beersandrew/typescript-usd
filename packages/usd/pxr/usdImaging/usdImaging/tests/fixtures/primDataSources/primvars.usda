#usda 1.0

def Xform "Primvars" (
    prepend apiSchemas = ["ColorSpaceAPI"]
)
{
    uniform token colorSpace:name = "lin_rec709_scene"
    texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1)] (
        interpolation = "faceVarying"
    )
    int[] primvars:st:indices = [0, 1, 2, 2, 1, 0]
    color3f[] primvars:displayColor = [(1, 0, 0)] (
        interpolation = "constant"
    )
    float[] primvars:displayOpacity = [0.5]
    float[] primvars:widthsLike = [1, 2, 3, 4] (
        interpolation = "vertex"
        elementSize = 2
    )
    normal3f[] primvars:myNormals = [(0, 0, 1)] (
        interpolation = "uniform"
    )
    vector3f primvars:myVector = (1, 2, 3)
    point3f[] primvars:points = [(0, 0, 0)]
    vector3f[] primvars:velocities = [(0, 0, 0)]
    vector3f[] primvars:accelerations = [(0, 0, 0)]
    string primvars:label = "hello"
    float primvars:declaredOnly
    float primvars:animated.timeSamples = {
        1: 1,
        2: 2,
    }
    float[] primvars:animIndexed = [1, 2]
    int[] primvars:animIndexed:indices.timeSamples = {
        1: [0, 1],
        2: [1, 0],
    }
    rel primvars:target = </Other>
    float notAPrimvar = 1
}

def Scope "Other"
{
    int primvars:onScope = 3
}

def "TypelessPrimvars"
{
    color3f primvars:tint = (0, 1, 0)
}
