#usda 1.0
(
    upAxis = "Y"
)

def BasisCurves "Curves"
{
    int[] curveVertexCounts = [4, 4]
    uniform token type = "cubic"
    uniform token basis = "bspline"
    uniform token wrap = "periodic"
    point3f[] points = [(0, 0, 0), (1, 1, 0), (2, 0, 0), (3, 1, 0), (0, 0, 1), (1, 1, 1), (2, 0, 1), (3, 1, 1)]
    float[] widths = [0.1, 0.2] (
        interpolation = "uniform"
    )
    normal3f[] normals = [(0, 0, 1), (0, 0, 1)] (
        interpolation = "uniform"
    )
    vector3f[] accelerations = [(0, -9.8, 0), (0, -9.8, 0), (0, -9.8, 0), (0, -9.8, 0), (0, -9.8, 0), (0, -9.8, 0), (0, -9.8, 0), (0, -9.8, 0)]
}

def BasisCurves "LinearCurves"
{
    int[] curveVertexCounts = [2]
    point3f[] points = [(0, 0, 0), (0, 1, 0)]
}

def Points "Points"
{
    point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    float[] widths = [0.5, 1, 1.5] (
        interpolation = "vertex"
    )
    vector3f[] velocities = [(1, 0, 0), (1, 0, 0), (1, 0, 0)]
}
