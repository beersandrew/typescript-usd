#usda 1.0
(
    upAxis = "Y"
)

def Xform "Bounds" (
    prepend apiSchemas = ["GeomModelAPI"]
    kind = "component"
)
{
    uniform bool model:applyDrawMode = 1
    uniform token model:drawMode = "bounds"
    float3 model:drawModeColor = (1, 0, 0)
    double3 xformOp:translate = (1, 2, 3)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Mesh "Geom"
    {
        float3[] extent = [(-1, -1, 0), (1, 1, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
    }
}

def Xform "Origin" (
    prepend apiSchemas = ["GeomModelAPI"]
    kind = "component"
)
{
    uniform bool model:applyDrawMode = 1
    uniform token model:drawMode = "origin"

    def Mesh "Geom"
    {
        float3[] extent = [(-1, -1, 0), (1, 1, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
    }
}

def Xform "Cards" (
    prepend apiSchemas = ["GeomModelAPI"]
    kind = "component"
)
{
    uniform bool model:applyDrawMode = 1
    uniform token model:drawMode = "cards"
    uniform token model:cardGeometry = "box"
    asset model:cardTextureXPos = @xpos.png@
    float3 model:drawModeColor = (0, 1, 0)

    def Mesh "Geom"
    {
        float3[] extent = [(-1, -1, 0), (1, 1, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
    }
}

def Xform "Default" (
    kind = "component"
)
{
    def Mesh "Geom"
    {
        float3[] extent = [(-1, -1, 0), (1, 1, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
    }
}
