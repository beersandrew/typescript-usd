def "inherited"
{
    color3f[] primvars:displayColor = [(0.2, 0.3, 0.4)] (
        interpolation = "constant"
    )

    def Mesh "Mesh" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        rel material:binding = </inherited/Material>
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        uniform token subdivisionScheme = "none"
    }

    def Material "Material"
    {
        token outputs:surface.connect = </inherited/Material/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </inherited/Material/Reader.outputs:result>
            token outputs:surface
        }

        def Shader "Reader"
        {
            uniform token info:id = "UsdPrimvarReader_float3"
            float3 inputs:fallback = (0.7, 0.6, 0.5)
            string inputs:varname = "displayColor"
            float3 outputs:result
        }
    }
}

def Material "uv0"
{
    token outputs:surface.connect = </uv0/Surface.outputs:surface>

    def Shader "Surface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </uv0/Tex.outputs:rgb>
        float inputs:metallic.connect = </uv0/RoughTex.outputs:b>
        float inputs:occlusion.connect = </uv0/RoughTex.outputs:r>
        float inputs:opacity.connect = </uv0/Tex.outputs:a>
        float inputs:roughness.connect = </uv0/RoughTex.outputs:g>
        token outputs:surface
    }

    def Shader "Tex"
    {
        uniform token info:id = "UsdUVTexture"
        asset inputs:file = @checker.png@
        float2 inputs:st.connect = </uv0/Transform.outputs:result>
        float outputs:a
        float3 outputs:rgb
    }

    def Shader "Reader"
    {
        uniform token info:id = "UsdPrimvarReader_float2"
        string inputs:varname = "st"
        float2 outputs:result
    }

    def Shader "Transform"
    {
        uniform token info:id = "UsdTransform2d"
        float2 inputs:in.connect = </uv0/Reader.outputs:result>
        float inputs:rotation = 0
        float2 inputs:scale = (2, 3)
        float2 inputs:translation = (0.25, 0.5)
        float2 outputs:result
    }

    def Shader "RoughTex"
    {
        uniform token info:id = "UsdUVTexture"
        asset inputs:file = @checker.png@
        float2 inputs:st.connect = </uv0/RoughTransform.outputs:result>
        float outputs:b
        float outputs:g
        float outputs:r
    }

    def Shader "RoughTransform"
    {
        uniform token info:id = "UsdTransform2d"
        float2 inputs:in.connect = </uv0/Reader.outputs:result>
        float inputs:rotation = 0
        float2 inputs:scale = (3, 2)
        float2 inputs:translation = (-0.5, 0.125)
        float2 outputs:result
    }
}

