#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)
def Xform "World"
{
    def Mesh "Universal" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    ) {
        uniform token subdivisionScheme = "none"
        point3f[] points = [(-1,-1,0), (1,-1,0), (1,1,0), (-1,1,0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0,1,2,3]
        color3f[] primvars:displayColor = [(0.25, 0.5, 0.75)]
        rel material:binding = </World/Looks/UniversalMtlx>
    }
    def Mesh "MtlxContext" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    ) {
        uniform token subdivisionScheme = "none"
        point3f[] points = [(2,-1,0), (4,-1,0), (4,1,0), (2,1,0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0,1,2,3]
        color3f[] primvars:displayColor = [(0.75, 0.5, 0.25)]
        rel material:binding = </World/Looks/MtlxContext>
    }
    def Mesh "Preview" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    ) {
        uniform token subdivisionScheme = "none"
        point3f[] points = [(5,-1,0), (7,-1,0), (7,1,0), (5,1,0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0,1,2,3]
        rel material:binding = </World/Looks/Preview>
    }
    def Scope "Looks"
    {
        def Material "UniversalMtlx"
        {
            token outputs:surface.connect = </World/Looks/UniversalMtlx/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (1, 0, 0)
                token outputs:out
            }
        }
        def Material "MtlxContext"
        {
            token outputs:mtlx:surface.connect = </World/Looks/MtlxContext/Surface.outputs:out>
            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0, 1, 0)
                token outputs:out
            }
        }
        def Material "Preview"
        {
            token outputs:surface.connect = </World/Looks/Preview/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 1)
                token outputs:surface
            }
        }
    }
}
