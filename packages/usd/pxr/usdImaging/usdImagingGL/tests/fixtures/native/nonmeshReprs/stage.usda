#usda 1.0
(upAxis="Y")
def Xform "World" {
 def Points "Cloud" {
  point3f[] points=[(-2.5,0,0)]
  float[] widths=[0.65] (interpolation="constant")
  color3f[] primvars:displayColor=[(0.2,0.5,0.9)]
 }
 def BasisCurves "Linear" {
  token type="linear"
  token wrap="nonperiodic"
  int[] curveVertexCounts=[4]
  point3f[] points=[(-0.5,-0.7,0),(0.5,0.7,0),(1.5,-0.7,0),(2.5,0.7,0)]
  float[] widths=[0.3] (interpolation="constant")
  normal3f[] normals=[(0,0,1)] (interpolation="constant")
  color3f[] primvars:displayColor=[(0.3,0.8,0.3)]
 }
 def BasisCurves "Cubic" {
  token type="cubic"
  token basis="bezier"
  token wrap="nonperiodic"
  int[] curveVertexCounts=[4]
  point3f[] points=[(-2.7,-1.4,0),(-2.2,-0.4,0),(-1.5,-0.4,0),(-1,-1.4,0)]
  float[] widths=[0.3] (interpolation="constant")
  color3f[] primvars:displayColor=[(0.8,0.3,0.2)]
 }
}
def Camera "Camera" {
 float focalLength=50
 float horizontalAperture=36
 float verticalAperture=24
 double3 xformOp:translate=(0,0,11)
 uniform token[] xformOpOrder=["xformOp:translate"]
}
