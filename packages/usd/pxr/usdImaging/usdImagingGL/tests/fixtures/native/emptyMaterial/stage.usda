#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)
def Xform "World" {
    def Material "Physics" (prepend apiSchemas = ["PhysicsMaterialAPI"]) {
        float physics:dynamicFriction = 0.58
    }
    def Mesh "Bound" {
        rel material:binding = </World/Physics>
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-2, 0, 0), (-0.5, 0, 0), (-0.5, 1.5, 0), (-2, 1.5, 0)]
        color3f[] primvars:displayColor = [(0.2, 0.7, 0.3)]
    }
    def Mesh "Unbound" {
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(0.5, 0, 0), (2, 0, 0), (2, 1.5, 0), (0.5, 1.5, 0)]
        color3f[] primvars:displayColor = [(0.2, 0.7, 0.3)]
    }
}
