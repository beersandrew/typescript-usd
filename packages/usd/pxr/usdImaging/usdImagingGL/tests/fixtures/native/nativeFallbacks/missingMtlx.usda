#usda 1.0
(upAxis = "Y")
def Material "Material" {
 token outputs:mtlx:surface.connect = </Material/Surface.outputs:out>
 def Shader "Surface" {
  uniform token info:id = "ND_standard_surface_surfaceshader"
  float inputs:base = 1
  float inputs:metalness = 1
  float inputs:specular = 0
  float inputs:coat = 1
  color3f inputs:coat_color.connect = </Material/Color.outputs:out>
  float inputs:specular_roughness.connect = </Material/Roughness.outputs:out>
  token outputs:out
 }
 def Shader "Color" {
  uniform token info:id = "ND_tiledimage_color3"
  asset inputs:file = @missing_color.png@
  color3f outputs:out
 }
 def Shader "Roughness" {
  uniform token info:id = "ND_tiledimage_float"
  asset inputs:file = @missing_roughness.png@
  float outputs:out
 }
}
def Mesh "Quad" (
 prepend apiSchemas = ["MaterialBindingAPI"]
) {
 rel material:binding = </Material>
 point3f[] points = [(-1,-1,0),(1,-1,0),(1,1,0),(-1,1,0)]
 int[] faceVertexCounts = [4]
 int[] faceVertexIndices = [0,1,2,3]
 token subdivisionScheme = "none"
 float2[] primvars:st = [(0,0),(1,0),(1,1),(0,1)] (interpolation = "vertex")
}
def Camera "Camera" {
 float focalLength = 50
 float horizontalAperture = 36
 float verticalAperture = 24
 double3 xformOp:translate = (0,0,6)
 uniform token[] xformOpOrder = ["xformOp:translate"]
}
