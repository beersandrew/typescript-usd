#usda 1.0
(upAxis = "Y")
def Material "Material" {
 token outputs:mtlx:surface.connect = </Material/Surface.outputs:out>
 def Shader "Surface" {
  uniform token info:id = "ND_standard_surface_surfaceshader"
  float inputs:base = 1
  color3f inputs:base_color.connect = </Material/Reader.outputs:out>
  token outputs:out
 }
 def Shader "Reader" {
  uniform token info:id = "ND_UsdPrimvarReader_vector3"
  token inputs:varname = "custom_color"
  color3f inputs:fallback = (0.18, 0.4, 0.8)
  color3f outputs:out
 }
}
def Mesh "Quad" (
 prepend apiSchemas = ["MaterialBindingAPI"]
) {
 rel material:binding = </Material>
 point3f[] points = [(-1,-1,0),(1,-1,0),(1,1,0),(-1,1,0)]
 int[] faceVertexCounts = [4]
 int[] faceVertexIndices = [0,1,2,3]
 token subdivisionScheme = "none"
 float2[] primvars:st = [(0,0),(1,0),(1,1),(0,1)] (interpolation = "vertex")
 color3f[] primvars:displayColor = [(0.2, 0.6, 0.3)] (interpolation = "constant")
 float3 primvars:custom_color = (0.8, 0.15, 0.05) (interpolation = "constant")
}
def Camera "Camera" {
 float focalLength = 50
 float horizontalAperture = 36
 float verticalAperture = 24
 double3 xformOp:translate = (0,0,6)
 uniform token[] xformOpOrder = ["xformOp:translate"]
}
