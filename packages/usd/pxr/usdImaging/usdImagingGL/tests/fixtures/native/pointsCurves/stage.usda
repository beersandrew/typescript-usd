def BasisCurves "Linear"
{
    int[] curveVertexCounts = [3]
    point3f[] points = [(0, 0, 0), (1, 1, 0), (2, 0, 0)]
    float[] primvars:widths = [0.6, 0.8] (
        interpolation = "vertex"
    )
    int[] primvars:widths:indices = [0, 1, 0]
    uniform token type = "linear"
    float[] widths = [0.1, 0.2, 0.3] (
        interpolation = "vertex"
    )
}

