#usda 1.0

def "World" (
    prepend apiSchemas = ["SemanticsLabelsAPI:style", "SemanticsLabelsAPI:category"]
)
{
    token[] semantics:labels:category = ["object"]
    token[] semantics:labels:style = ["red", "big", "big", "", "😀"]

    def "Group"
    {
        def "Child" (
            prepend apiSchemas = ["SemanticsLabelsAPI:style", "SemanticsLabelsAPI:category", "SemanticsLabelsAPI:category:detail"]
        )
        {
            token[] semantics:labels:category = ["chair"]
            token[] semantics:labels:category:detail = ["nested"]
            token[] semantics:labels:style = ["small", "red"]
            token[] semantics:labels:style.timeSamples = {
                1: ["early", "early"],
                3: ["late"],
            }
        }

        def "Empty" (
            prepend apiSchemas = ["SemanticsLabelsAPI:style"]
        )
        {
        }
    }

    def "Blocked" (
        prepend apiSchemas = ["SemanticsLabelsAPI:style"]
    )
    {
        token[] semantics:labels:style = None
    }
}

def "Orphan"
{
    custom token[] semantics:labels:style = ["not_applied"]
}

def "NoLabels"
{
}

def "WrongType" (
    prepend apiSchemas = ["SemanticsLabelsAPI:style"]
)
{
    float[] semantics:labels:style = [1, 2]
}

