#usda 1.0
(
    doc = "sub doc"
    customLayerData = {
        string note = "sub"
        string subOnly = "s"
    }
    timeCodesPerSecond = 48
)

over "World" (
    customData = {
        asset a = @./weak.usd@
        asset b = @./b.usd@
    }
)
{
    double withMeta (
        customData = {
            asset q = @./q.usd@
        }
        doc = "from sub"
    )
    asset subAsset = @./subAsset.usd@
    double subSamples.timeSamples = {
        48: 5,
        96: None,
    }
}
