#usda 1.0

def Mesh "intScalar"
{
    normal3f[] normals = 7
}

def Mesh "doubleScalar"
{
    normal3f[] normals = 7.5
}

def Mesh "vecScalar"
{
    normal3f[] normals = (0, 0, 1)
}

def Mesh "intArray"
{
    normal3f[] normals = [0, 1, 3]
}

def Mesh "doubleVecArray"
{
    normal3f[] normals = [(0.1, 0.2, 1)]
}

def Mesh "roleOnly"
{
    normal3f[] normals = [(0, 0, 1)]
}

def Mesh "samples"
{
    normal3f[] normals.timeSamples = {
        1: 4,
        2: 5,
    }
}

