#usda 1.0

def Mesh "intScalar"
{
    int normals = 7
}

def Mesh "doubleScalar"
{
    double normals = 7.5
}

def Mesh "vecScalar"
{
    point3f normals = (0, 0, 1)
}

def Mesh "intArray"
{
    int[] normals = [0, 1, 3]
}

def Mesh "doubleVecArray"
{
    point3d[] normals = [(0.1, 0.2, 1)]
}

def Mesh "roleOnly"
{
    color3f[] normals = [(0, 0, 1)]
}

def Mesh "samples"
{
    int normals.timeSamples = {
        1: 4,
        2: 5,
    }
}
