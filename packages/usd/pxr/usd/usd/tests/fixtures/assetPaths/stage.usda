#usda 1.0
(subLayers = [@./sub/layer.usda@])
def Scope "Asset" (
 clips = { dictionary default = {
  asset[] assetPaths = [@./clips/clip.usda@]
  string primPath = "/Asset"
  double2[] active = [(0, 0)]
  double2[] times = [(0, 0), (2, 2)]
 } }
) {
 asset found = @./existing.txt@
 asset missing = @./missing.txt@
 asset empty = @@
 asset args = @./existing.txt:SDF_FORMAT_ARGS:a=b@
 asset anonymous = @anon:asset@
 asset[] paths = [@./existing.txt@, @./missing.txt@, @@]
 asset sampled.timeSamples = {
  1: @./existing.txt@,
  2: @./missing.txt@,
 }
 asset clipped
}
