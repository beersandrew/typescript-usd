#usda 1.0
(
    defaultPrim = "Root"
    subLayers = [@second.usda@]
)
class "RootBaseClass" {
    int fromRootBaseClass = 12
    def "FirstChild" { int fromFirstChild:RootBaseClass = 12 ; }
    def "InheritedChild" {}
}
def "Root" (
    prepend inherits = </RootBaseClass>
    prepend references = @reference.usda@
) {
    def "FirstChild" { int fromFirstChild = 0 ; }
}
def "WithVariants" (
    variants = { string Height = "short" }
    prepend variantSets = "Height"
) {
    variantSet "Height" = {
        "short" { def "Short" {}
}
        "tall" { def "Tall" {}
}
    }
}
def "Sleeping" (active = false) { def "SleepingChild" {}
}
