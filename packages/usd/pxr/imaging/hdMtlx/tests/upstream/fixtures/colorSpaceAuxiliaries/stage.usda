#usda 1.0
def Scope "World" (prepend apiSchemas = ["ColorSpaceAPI"]) {
 uniform token colorSpace:name = "lin_p3d65_scene"
 def Material "Material" {
  token outputs:mtlx:surface.connect = </World/Material/Surface.outputs:out>
  def Shader "Surface" {
   uniform token info:id = "ND_surface_unlit"
   color3f inputs:emission_color.connect = </World/Material/Multiply.outputs:out>
   token outputs:out
  }
  def Shader "Multiply" {
   uniform token info:id = "ND_multiply_color3"
   color3f inputs:in1 = (0.2,0.4,0.8)
   token inputs:in1:colorSpace:name = "none"
   color3f inputs:in2.connect = </World/Material/Image.outputs:out>
   color3f outputs:out
  }
  def Shader "Image" {
   uniform token info:id = "ND_image_color3"
   asset inputs:file = @example.png@
   token inputs:file:colorSpace:name = "srgb_rec709_scene"
   color3f outputs:out
  }
 }
}
