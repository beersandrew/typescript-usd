{
  "comment": "Input networks for capture.cpp and materialXFilter.test.ts (both read this file). Each case is applied in order on one HdStResourceRegistry per 'registry' kind, so later cases see the MaterialX shaders earlier ones cached. Values: [type, value] with type float|int|bool|string|token|asset|float2|float3|float4.",
  "cases": [
    {
      "name": "ssTextured",
      "registry": "gl",
      "materialPath": "/Mat",
      "terminal": "/Mat/Surface",
      "terminals": {
        "surface": "/Mat/Surface"
      },
      "nodes": {
        "/Mat/Surface": {
          "type": "ND_standard_surface_surfaceshader",
          "parameters": {
            "base": ["float", 0.9],
            "metalness": ["float", 0.25]
          },
          "connections": {
            "base_color": [["/Mat/Image", "out"]]
          }
        },
        "/Mat/Image": {
          "type": "ND_image_color3",
          "parameters": {
            "file": ["asset", "texture.png"],
            "uaddressmode": ["string", "clamp"],
            "filtertype": ["string", "closest"]
          },
          "connections": {
            "texcoord": [["/Mat/UV", "out"]]
          }
        },
        "/Mat/UV": {
          "type": "ND_texcoord_vector2",
          "parameters": {
            "index": ["int", 0]
          }
        }
      }
    },
    {
